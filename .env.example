PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (TiDB Cloud uses port 4000 and requires TLS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=airline_booking_db
DB_USER=root
DB_PASS=
DB_SSL=false
# Required only when DB_SSL=true. Use a PEM value with newline characters escaped as \n.
DB_SSL_CA=

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_different_from_jwt_secret
JWT_REFRESH_EXPIRES_IN=7d

# Holding time config (minutes)
HOLDING_TIME_MINUTES=15
SEAT_WARNING_THRESHOLD=5

# VNPAY Sandbox Config
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return

# MoMo Sandbox Config
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo-return
MOMO_IPN_URL=http://localhost:5000/api/v1/payments/momo/ipn

# Mailer Config
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Airline Booking" <noreply@airlinebooking.com>
