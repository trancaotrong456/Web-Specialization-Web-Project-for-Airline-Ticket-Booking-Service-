PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (TiDB Cloud uses port 4000 and requires TLS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=airline_booking_db
DB_USER=root
DB_PASS=
DB_SSL=false
# Required only when DB_SSL=true. Use a PEM value with newline characters escaped as \n.
DB_SSL_CA=
SEED_ADMIN_EMAIL=admin@airline-booking.local
SEED_ADMIN_PASSWORD=
# Shared password for synthetic staff/customer accounts created by the demo seeder.
SEED_USER_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_different_from_jwt_secret
JWT_REFRESH_EXPIRES_IN=7d
# Frontend page that accepts the reset token. Production must use HTTPS.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30

# Holding time config (minutes)
HOLDING_TIME_MINUTES=15
# Extra time allowed for a gateway callback after the booking hold expires.
PAYMENT_PENDING_GRACE_MINUTES=5
# Keep false on a database containing historical synthetic pending bookings.
ENABLE_PENDING_RECONCILIATION=false
SEAT_WARNING_THRESHOLD=5

# VNPAY Sandbox Config
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return
# Optional comma-separated origins accepted when a client supplies return_url.
# In production, use HTTPS origins only (for example https://app.example.com).
PAYMENT_RETURN_URL_ALLOWLIST=http://localhost:3000

# payOS / VietQR Config
# disabled: VNPay remains available; payOS requests return 503.
# demo: local academic QR + signed simulated webhook; forbidden in production.
# live: real payOS API and webhook; requires the three credentials below.
PAYOS_MODE=disabled
PAYOS_DEMO_SECRET=change_this_local_demo_secret
# Create a payment channel in my.payos.vn only when PAYOS_MODE=live.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Only a signed webhook confirms success. A cancellation redirect is re-checked with payOS.
PAYOS_RETURN_URL=http://localhost:5000/api/v1/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:5000/api/v1/payments/payos/return
# Register this HTTPS endpoint with payOS after deployment.
PAYOS_WEBHOOK_URL=http://localhost:5000/api/v1/payments/payos/webhook

# Set true only for isolated smoke tests that must not run the expiry cron.
DISABLE_CRON=false

# Email delivery via Resend HTTPS API (SMTP_* is no longer used)
RESEND_API_KEY=
# Use a sender/domain verified in your Resend account. The default is suitable
# only for limited Resend test sending.
EMAIL_FROM="Airline Booking" <onboarding@resend.dev>
