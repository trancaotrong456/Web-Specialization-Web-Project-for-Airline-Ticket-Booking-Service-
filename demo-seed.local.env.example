# Copy to demo-seed.local.env for a local Docker demo only.
# Use unique demo-only passwords; never reuse real account credentials.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Set once before the first --apply. Must be 1-7 days in the future (Vietnam time).
# Keep this date unchanged on reruns; the seeder refuses to create a second schedule.
SEED_FLIGHT_START_DATE=
