{
  "name": "airline-booking-backend",
  "version": "1.0.0",
  "description": "Flight Ticket Booking System — Node.js + Express + Sequelize + MySQL",
  "main": "server.js",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test CLIENT_URL=http://localhost:5173 VNPAY_MODE=sandbox VNP_TMN_CODE=TEST_TMN VNP_HASH_SECRET=test-only-vnpay-secret node --test tests/*.test.js",
    "test:integration:mysql": "node --env-file=.env.integration --test --test-concurrency=1 tests/integration/*.mysql.test.js",
    "test:integration": "node --env-file=.env.integration --test --test-concurrency=1 tests/integration/*.mysql.test.js",
    "test:seed:demo": "node --test scripts/seed-demo-local.test.js scripts/seed-demo-docker.test.js scripts/demo-seed-prerequisites.test.js scripts/demo-setup.test.js scripts/demo-up.test.js tests/demoBootstrap.test.js seeders/demo/DatabaseSeeder.test.js",
    "seed:demo:docker": "node scripts/seed-demo-docker.js",
    "demo:setup": "node scripts/demo-setup.js",
    "demo:up": "node scripts/demo-up.js",
    "smoke:payos-demo": "node scripts/smoke-tests/payos-demo-smoke.js"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.24.4",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "resend": "^6.28.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "mammoth": "^1.12.3",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3"
  }
}
