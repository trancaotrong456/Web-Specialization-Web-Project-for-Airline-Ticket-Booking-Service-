# Local-only Docker Compose demo settings. Do not use for Render/TiDB production.
APP_PORT=5000
MYSQL_PORT=3307
MYSQL_DATABASE=airline_booking_docker
MYSQL_USER=airline_user
MYSQL_PASSWORD=airline_demo_password
MYSQL_ROOT_PASSWORD=root_demo_password
HOLDING_TIME_MINUTES=15
PAYMENT_PENDING_GRACE_MINUTES=5
ENABLE_PENDING_RECONCILIATION=true
